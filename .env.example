# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` — it is listed in .gitignore.

DNOTIFIER_APP_ID=your-app-id-here
DNOTIFIER_SECRET=your-app-secret-here
DNOTIFIER_USER_ID=svc-repoguard
DNOTIFIER_RECEIVER_ID=dev-lead
DNOTIFIER_AI_PROVIDER=openai
DNOTIFIER_AI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible fallback engine
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MAX_SNIPPET_CHARS=12000
